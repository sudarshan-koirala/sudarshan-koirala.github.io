---
import Base from '../layouts/Base.astro';
import { experience, education, skillGroups, languages } from '../data/profile';
---

<Base title="About" description="Sudarshan Koirala - Senior GenAI Engineer at KONE, former Machine Learning Engineer and Data Scientist at KONE, content creator, and AI educator based in Finland.">
  <div class="container-wide">
    <div class="about-layout">
      <aside class="about-toc" aria-label="Table of contents">
        <div class="toc-title">Table of contents</div>
        <a href="#profile">Profile</a>
        <a href="#work">Work</a>
        <a href="#expertise">Expertise</a>
        <a href="#education">Education</a>
        <a href="#skills">Skills</a>
        <a href="#contact">Contact</a>
      </aside>

      <article class="about-main">
        <header class="page-header about-header">
          <p class="eyebrow">Short bio and expertise</p>
          <h1>About</h1>
        </header>

        <section id="profile" class="section about-intro" style="padding-top:0;">
          <img src="/profile.png" alt="Sudarshan Koirala" class="about-photo" width="136" height="136" />
          <div>
            <p>
              I am Sudarshan Koirala, a Senior GenAI Engineer at
              <a href="https://www.kone.com" target="_blank" rel="noopener">KONE</a>
              in Espoo, Finland. My work focuses on enterprise agentic AI, generative AI, MLOps,
              data platforms, and practical AI systems that move from prototype to production.
            </p>
            <p>
              I joined KONE in January 2022 as a Data Scientist Trainee and grew into Data Scientist and
              Machine Learning Engineer roles before becoming Senior GenAI Engineer in August 2024,
              building machine learning and data science solutions across industrial and enterprise contexts.
              Earlier, I worked with Nokia Solutions and Networks on NLP and deep learning projects.
            </p>
            <p>
              I also run
              <a href="https://www.youtube.com/@datasciencebasics" target="_blank" rel="noopener">Data Science Basics</a>
              on YouTube, where I teach AI, data science, LLMs, Databricks, and developer tools in a simple,
              practical way. I write on
              <a href="https://medium.com/@sudarshan-koirala" target="_blank" rel="noopener">Medium</a>
              and share projects on
              <a href="https://github.com/sudarshan-koirala" target="_blank" rel="noopener">GitHub</a>.
            </p>
            <p class="doc-callout">Check out my Resume and CV here:</p>
            <div class="doc-links" aria-label="Resume and CV links">
              <a href="/resume">
                <span class="button-icon icon-resume" aria-hidden="true"></span>
                <span>Resume</span>
              </a>
              <a href="/cv">
                <span class="button-icon icon-cv" aria-hidden="true"></span>
                <span>CV</span>
              </a>
            </div>
          </div>
        </section>

        <section id="work" class="section">
          <h2 class="section-title">Work</h2>
          <p>
            I focus on two connected areas:
          </p>
          <ol class="about-list">
            <li>
              Building enterprise AI and ML systems with cloud platforms, LLMs, orchestration,
              evaluation, observability, and MLOps practices.
            </li>
            <li>
              Teaching AI and data science through tutorials, articles, and examples that help developers
              and analysts apply modern tools without unnecessary complexity.
            </li>
          </ol>

          {experience.map((role) => (
            <div class="timeline-item">
              <div class="timeline-role">{role.title}</div>
              <div class="timeline-company">{role.company}</div>
              <div class="timeline-dates">{role.dates}{role.location && ` · ${role.location}`}</div>
              <p class="timeline-desc">{role.summary}</p>
            </div>
          ))}
        </section>

        <section id="expertise" class="section">
          <h2 class="section-title">Expertise</h2>
          <div class="expertise-grid">
            <div>
              <h3>Enterprise AI</h3>
              <p>
                Generative AI systems, RAG, LLM prototyping, production workflows, enterprise evaluation,
                and applied AI engineering.
              </p>
            </div>
            <div>
              <h3>Data Platforms</h3>
              <p>
                Databricks, Spark, SQL, AWS, Azure, MLflow, orchestration, and cloud-native data science workflows.
              </p>
            </div>
            <div>
              <h3>MLOps</h3>
              <p>
                Automated ML workflows, CI/CD, model tracking, deployment practices, monitoring, reliability,
                and team enablement.
              </p>
            </div>
            <div>
              <h3>Education</h3>
              <p>
                Practical teaching through YouTube, Medium, and hands-on tutorials for AI, LLMs, and data science tools.
              </p>
            </div>
          </div>
        </section>

        <section id="education" class="section">
          <h2 class="section-title">Education</h2>

          {education.map((item) => (
            <div class="timeline-item">
              <div class="timeline-role">{item.degree}</div>
              <div class="timeline-company">{item.school}</div>
              <div class="timeline-dates">{item.dates}</div>
              {item.details && <p class="timeline-desc">{item.details.join(' · ')}</p>}
            </div>
          ))}
        </section>

        <section id="skills" class="section">
          <h2 class="section-title">Skills</h2>

          {[...skillGroups, { title: 'Languages', items: languages }].map((group) => (
            <div class="skill-group">
              <div class="skill-group-title">{group.title}</div>
              <div class="skill-pills">
                {group.items.map((item) => <span class="skill-pill">{item}</span>)}
              </div>
            </div>
          ))}
        </section>

        <section id="contact" class="section">
          <h2 class="section-title">Contact</h2>
          <p>
            For business inquiries:
            <a href="mailto:basicsdatascience@gmail.com">basicsdatascience@gmail.com</a>
          </p>
          <p>
            For consulting:
            <a href="https://topmate.io/sudarshan_koirala" target="_blank" rel="noopener">topmate.io/sudarshan_koirala</a>
          </p>
          <div class="hero-links compact-links">
            <a href="https://sudarshan-koirala.github.io" target="_blank" rel="noopener">Website</a>
            <a href="https://www.linkedin.com/in/sudarshan-koirala/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://github.com/sudarshan-koirala" target="_blank" rel="noopener">GitHub</a>
            <a href="https://twitter.com/mesudarshan" target="_blank" rel="noopener">Twitter/X</a>
            <a href="https://www.youtube.com/@datasciencebasics" target="_blank" rel="noopener">YouTube</a>
          </div>
        </section>
      </article>
    </div>
  </div>
</Base>
