---
import Base from '../layouts/Base.astro';
import {
  contact,
  summary,
  stats,
  experience,
  education,
  skillGroups,
  languages,
  openSource,
  products,
  selectedWriting,
} from '../data/profile';
---

<Base title="CV" description="Curriculum vitae of Sudarshan Koirala: Senior GenAI Engineer at KONE building agentic AI solutions, former ML Engineer and Data Scientist, ex-Nokia ML trainee, Aalto University M.Sc., and creator of Data Science Basics.">
  <div class="container document-container cv-container">
    <header class="document-header">
      <div>
        <p class="eyebrow">Curriculum Vitae</p>
        <h1>{contact.name}</h1>
        <p class="document-role">{contact.headline} · Agentic AI · Generative AI · MLOps · Data platforms · AI education</p>
        <p class="document-contact">
          <span>{contact.location}</span>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          {contact.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
          ))}
          <a class="print-only" href={contact.website}>{contact.website.replace('https://', '')}</a>
        </p>
      </div>
      <button class="print-link" type="button" onclick="window.print()">
        <span class="button-icon icon-print" aria-hidden="true"></span>
        <span>Print / Save PDF</span>
      </button>
    </header>

    <section class="document-section">
      <h2>Profile</h2>
      <p class="document-lead">{summary}</p>
      <dl class="stat-strip">
        {stats.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="document-section">
      <h2>Core Competencies</h2>
      <div class="skill-table">
        {skillGroups.map((group) => (
          <div>
            <h3>{group.title}</h3>
            <p>{group.items.join(' · ')}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="document-section">
      <h2>Professional Experience</h2>
      {experience.map((role) => (
        <div class="document-item">
          <div class="document-item-head">
            <h3>{role.title}</h3>
            <span>{role.dates}</span>
          </div>
          <p class="document-org">
            {role.companyUrl ? (
              <a href={role.companyUrl} target="_blank" rel="noopener">{role.company}</a>
            ) : role.company}
            {role.location && <span> · {role.location}</span>}
          </p>
          <p>{role.summary}</p>
          <ul>
            {role.highlights.map((item) => <li>{item}</li>)}
          </ul>
          {role.stack && (
            <p class="document-stack"><strong>Stack:</strong> {role.stack.join(', ')}</p>
          )}
        </div>
      ))}
    </section>

    <section class="document-section">
      <h2>Education</h2>
      {education.map((item) => (
        <div class="document-item compact">
          <div class="document-item-head">
            <h3>{item.degree}</h3>
            <span>{item.dates}</span>
          </div>
          <p class="document-org">{item.school}</p>
          {item.details && <p>{item.details.join(' · ')}</p>}
        </div>
      ))}
    </section>

    <section class="document-section">
      <h2>Open-Source Work</h2>
      {openSource.map((project) => (
        <div class="document-item compact">
          <div class="document-item-head">
            <h3><a href={project.href} target="_blank" rel="noopener">{project.title}</a></h3>
            {project.meta && <span>{project.meta}</span>}
          </div>
          <p>{project.text}</p>
        </div>
      ))}
    </section>

    <section class="document-section">
      <h2>Side Projects</h2>
      {products.map((project) => (
        <div class="document-item compact">
          <div class="document-item-head">
            <h3><a href={project.href} target="_blank" rel="noopener">{project.title}</a></h3>
            {project.meta && <span>{project.meta}</span>}
          </div>
          <p>{project.text}</p>
        </div>
      ))}
    </section>

    <section class="document-section">
      <h2>Selected Writing</h2>
      <ul>
        {selectedWriting.map((post) => (
          <li><a href={post.href} target="_blank" rel="noopener">{post.title}</a></li>
        ))}
      </ul>
      <p>
        More on <a href="/blog">the blog</a>, <a href="https://medium.com/@sudarshan-koirala" target="_blank" rel="noopener">Medium</a>
        and the weekly LinkedIn newsletter
        <a href="https://www.linkedin.com/newsletters/the-agent-brief-7482745760560697344" target="_blank" rel="noopener">The Agent Brief</a>.
      </p>
    </section>

    <section class="document-section">
      <h2>Professional Interests</h2>
      <ul>
        <li>Reliable enterprise AI systems and MLOps practices for production teams.</li>
        <li>LLM application design, evaluation, observability and AI agent workflows.</li>
        <li>Teaching complex AI and data platform concepts in practical, beginner-friendly ways.</li>
      </ul>
    </section>

    <section class="document-section">
      <h2>Languages</h2>
      <p>{languages.join(' · ')}</p>
    </section>
  </div>
</Base>
