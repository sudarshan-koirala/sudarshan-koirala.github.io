---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts } from '../data/posts';
import { stats, products, openSource, experience, education, recognition } from '../data/profile';

const posts = (await getAllPosts()).slice(0, 3);

const focusAreas = [
  {
    title: 'Enterprise Agentic AI',
    text: 'Production-oriented AI agents, LLM applications, RAG, workflow automation, evaluation, and reliability practices for enterprise teams.',
  },
  {
    title: 'Data & ML Platforms',
    text: 'Databricks, Spark, Python, SQL, MLflow, cloud services, and the engineering practices that move models from notebooks to operations.',
  },
  {
    title: 'AI Education',
    text: 'Practical tutorials and articles that explain AI, data science, developer tools, and agent workflows without unnecessary complexity.',
  },
];

const projects = [
  ...products.map((p) => ({ ...p, label: p.meta ?? 'Project' })),
  ...openSource.slice(0, 4).map((p) => ({ ...p, label: p.meta ? `GitHub · ${p.meta.split(' · ')[0]}` : 'GitHub' })),
];

// Career at a glance: work roles (not the side channel) plus the master's degree.
const milestones = [
  ...experience
    .filter((role) => role.company !== 'Data Science Basics')
    .map((role) => ({ dates: role.dates, title: role.title, org: role.company })),
  { dates: education[0].dates, title: education[0].degree, org: education[0].school },
];

const channels = [
  {
    label: 'YouTube',
    title: 'Data Science Basics',
    text: 'Hands-on videos covering AI, Databricks, LLMs, agents, and modern developer tools.',
    href: 'https://www.youtube.com/@datasciencebasics',
  },
  {
    label: 'Medium',
    title: 'Articles and explainers',
    text: 'Written breakdowns of AI engineering patterns, data platforms, LLM tools, and emerging workflows.',
    href: 'https://medium.com/@sudarshan-koirala',
  },
  {
    label: 'GitHub',
    title: 'Code and experiments',
    text: 'Public projects, examples, and technical work shared for developers learning applied AI.',
    href: 'https://github.com/sudarshan-koirala',
  },
  {
    label: 'Newsletter',
    title: 'The Agent Brief',
    text: 'A weekly LinkedIn newsletter with practical updates on AI agents, LLMs, and the tools shaping the field.',
    href: 'https://www.linkedin.com/newsletters/the-agent-brief-7482745760560697344',
  },
];
---

<Base
  title="Sudarshan Koirala - Senior GenAI Engineer, Databricks MVP, and AI Educator"
  description="Sudarshan Koirala is a Senior GenAI Engineer at KONE building agentic AI solutions, Databricks MVP, creator of Data Science Basics, and writer on AI, Databricks, LLMs, MLOps, and developer tools."
>
  <section class="hero">
    <div class="container-wide">
      <div class="hero-inner">
        <div class="hero-text">
          <p class="eyebrow">Senior GenAI Engineer · Databricks MVP · AI educator</p>
          <h1><span class="hand-underline">Sudarshan Koirala</span></h1>
          <p class="hero-tagline">
            I build and ship enterprise agentic AI at <strong>KONE</strong>: AI agents, LLM applications, RAG,
            and the MLOps that keeps them reliable in production. I also teach applied AI to 24K+
            developers through Data Science Basics.
          </p>
          <div class="hero-actions">
            <a class="button-primary" href="/cv">View CV</a>
            <a class="button-secondary" href="/resume">Resume</a>
            <a class="button-secondary" href="/about">About me</a>
          </div>
          <div class="hero-links">
            <a href="https://www.linkedin.com/in/sudarshan-koirala/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://www.youtube.com/@datasciencebasics" target="_blank" rel="noopener">YouTube</a>
            <a href="https://medium.com/@sudarshan-koirala" target="_blank" rel="noopener">Medium</a>
            <a href="https://github.com/sudarshan-koirala" target="_blank" rel="noopener">GitHub</a>
            <a href="https://topmate.io/sudarshan_koirala" target="_blank" rel="noopener">Consulting</a>
          </div>
          <dl class="stat-strip hero-stats">
            {stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
        </div>
        <aside class="hero-profile" aria-label="Profile summary">
          <img src="/profile.png" alt="Sudarshan Koirala" class="hero-photo" width="160" height="160" />
          <a class="mvp-badge" href={recognition[0].href} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path fill="currentColor" d="M12 2.5l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.3l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9z" />
            </svg>
            <span class="mvp-badge-text">
              <strong>{recognition[0].title}</strong>
              <small>Recognized by {recognition[0].issuer}</small>
            </span>
          </a>
          <div>
            <span>Current role</span>
            <strong>Senior GenAI Engineer, KONE</strong>
          </div>
          <div>
            <span>Public work</span>
            <strong>Data Science Basics, Medium, GitHub</strong>
          </div>
          <div>
            <span>Location</span>
            <strong>Espoo, Finland</strong>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container-wide">
      <div class="section-head">
        <div>
          <p class="eyebrow">What I do</p>
          <h2 class="section-title-large">Enterprise AI work, explained in public.</h2>
        </div>
      </div>
      <div class="feature-grid">
        {focusAreas.map((area) => (
          <article class="feature-card">
            <h3>{area.title}</h3>
            <p>{area.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <div class="split-section">
        <div>
          <p class="eyebrow">Experience at a glance</p>
          <h2 class="section-title-large">From physics to production GenAI.</h2>
          <p>
            Physics degree in Nepal, software engineering and an M.Sc. in Computer Science in Finland,
            ML work at Nokia, then KONE since January 2022, growing from Data Scientist Trainee to
            Senior GenAI Engineer.
          </p>
          <div class="inline-actions">
            <a href="/cv">Read full CV</a>
            <a href="/resume">One-page resume</a>
          </div>
        </div>
        <ol class="career-list">
          {milestones.map((item) => (
            <li>
              <span class="career-dates">{item.dates}</span>
              <strong>{item.title}</strong>
              <span class="career-org">{item.org}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container-wide">
      <div class="section-head">
        <div>
          <p class="eyebrow">Public channels</p>
          <h2 class="section-title-large">Where to follow the work</h2>
        </div>
      </div>
      <div class="channel-grid">
        {channels.map((channel) => (
          <a class="channel-card" href={channel.href} target="_blank" rel="noopener">
            <span>{channel.label}</span>
            <h3>{channel.title}</h3>
            <p>{channel.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <div class="section-head">
        <div>
          <p class="eyebrow">Projects</p>
          <h2 class="section-title-large">Things I build and share</h2>
        </div>
      </div>
      <div class="channel-grid">
        {projects.map((project) => (
          <a class="channel-card" href={project.href} target="_blank" rel="noopener">
            <span>{project.label}</span>
            <h3>{project.title}</h3>
            <p>{project.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section-muted">
      <div class="container-wide">
        <div class="section-head">
          <div>
            <p class="eyebrow">Writing</p>
            <h2 class="section-title-large">Recent articles</h2>
          </div>
          <a href="/blog" class="section-link">View all</a>
        </div>
        <div class="card-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container-wide">
      <div class="cta-banner">
        <div>
          <p class="eyebrow">Say hello</p>
          <h2>Let's build or learn something together</h2>
          <p>
            Consulting, a collaboration, a question about a video, or just a friendly hello.
            The quickest ways to reach me are right here.
          </p>
        </div>
        <div class="cta-actions">
          <a href="mailto:basicsdatascience@gmail.com">Email</a>
          <a href="https://topmate.io/sudarshan_koirala" target="_blank" rel="noopener">Consulting</a>
          <a href="https://www.youtube.com/@datasciencebasics?sub_confirmation=1" target="_blank" rel="noopener">
            Subscribe
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
