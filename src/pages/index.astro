---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getAllPosts } from '../data/posts';
import { getVideos } from '../data/videos';
import { stats, products, openSource, experience, education, recognition, skillGroups } from '../data/profile';

const posts = (await getAllPosts()).slice(0, 3);
const videos = await getVideos(3);

// Phrases for the animated line in the hero.
const typedPhrases = [
  'AI agents that ship to production',
  'RAG systems on enterprise data',
  'LLM apps that teams rely on',
  'MLOps that keeps models reliable',
  'tutorials for 24K+ developers',
];

// Tools shown in the scrolling strip below the hero.
const techStrip = [...new Set(skillGroups.flatMap((group) => group.items))].filter(
  (item) => !['Evaluation', 'Monitoring', 'Deep learning', 'SRE practices', 'LLM application design', 'AI agents', 'JavaScript', 'Git', 'Linux'].includes(item),
);

const focusAreas = [
  {
    title: 'Enterprise Agentic AI',
    icon: 'agent',
    tags: ['AI agents', 'RAG', 'Evaluation'],
    text: 'Production-oriented AI agents, LLM applications, RAG, workflow automation, evaluation, and reliability practices for enterprise teams.',
  },
  {
    title: 'Data & ML Platforms',
    icon: 'platform',
    tags: ['Databricks', 'MLflow', 'Cloud'],
    text: 'Databricks, Spark, Python, SQL, MLflow, cloud services, and the engineering practices that move models from notebooks to operations.',
  },
  {
    title: 'AI Education',
    icon: 'teach',
    tags: ['YouTube', 'Medium', 'Open source'],
    text: 'Practical tutorials and articles that explain AI, data science, developer tools, and agent workflows without unnecessary complexity.',
  },
];

const projects = [
  ...products.map((p) => ({ ...p, label: p.meta ?? 'Project' })),
  ...openSource.slice(0, 4).map((p) => ({ ...p, label: p.meta ? `GitHub · ${p.meta.split(' · ')[0]}` : 'GitHub' })),
];

// Career at a glance: work roles (not the side channel) plus the master's degree.
const milestones = [
  ...experience
    .filter((role) => role.company !== 'Data Science Basics')
    .map((role) => ({ dates: role.dates, title: role.title, org: role.company })),
  { dates: education[0].dates, title: education[0].degree, org: education[0].school },
];

const channels = [
  {
    label: 'YouTube',
    icon: 'play',
    title: 'Data Science Basics',
    text: 'Hands-on videos covering AI, Databricks, LLMs, agents, and modern developer tools.',
    href: 'https://www.youtube.com/@datasciencebasics',
  },
  {
    label: 'Medium',
    icon: 'pen',
    title: 'Articles and explainers',
    text: 'Written breakdowns of AI engineering patterns, data platforms, LLM tools, and emerging workflows.',
    href: 'https://medium.com/@sudarshan-koirala',
  },
  {
    label: 'GitHub',
    icon: 'code',
    title: 'Code and experiments',
    text: 'Public projects, examples, and technical work shared for developers learning applied AI.',
    href: 'https://github.com/sudarshan-koirala',
  },
  {
    label: 'Newsletter',
    icon: 'mail',
    title: 'The Agent Brief',
    text: 'A weekly LinkedIn newsletter with practical updates on AI agents, LLMs, and the tools shaping the field.',
    href: 'https://www.linkedin.com/newsletters/the-agent-brief-7482745760560697344',
  },
];

const icons: Record<string, string> = {
  agent: '<circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="18" r="2.2"/><circle cx="19" cy="18" r="2.2"/><path d="M12 7.2v4.3M12 11.5l-5.6 4.8M12 11.5l5.6 4.8"/>',
  platform: '<path d="M12 3l8.5 4.5L12 12 3.5 7.5z"/><path d="M3.5 12L12 16.5 20.5 12"/><path d="M3.5 16.5L12 21l8.5-4.5"/>',
  teach: '<rect x="3" y="4.5" width="18" height="12.5" rx="2"/><path d="M10 8.3l5 2.5-5 2.5zM8 21h8"/>',
  play: '<rect x="3" y="5.5" width="18" height="13" rx="3.5"/><path d="M10.2 9.2l4.8 2.8-4.8 2.8z"/>',
  pen: '<path d="M4 20l1-4.5L16.5 4a2 2 0 0 1 2.8 0l.7.7a2 2 0 0 1 0 2.8L8.5 19z"/><path d="M14.5 6l3.5 3.5"/>',
  code: '<path d="M8.5 7.5L4 12l4.5 4.5M15.5 7.5L20 12l-4.5 4.5M13.2 5.5l-2.4 13"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3.5 7.5l8.5 6 8.5-6"/>',
};
---

<Base
  title="Sudarshan Koirala - Senior GenAI Engineer, Databricks MVP, and AI Educator"
  description="Sudarshan Koirala is a Senior GenAI Engineer at KONE building agentic AI solutions, Databricks MVP, creator of Data Science Basics, and writer on AI, Databricks, LLMs, MLOps, and developer tools."
>
  <section class="hero hero-wow">
    <canvas class="hero-canvas" aria-hidden="true" data-agent-canvas></canvas>
    <div class="container-wide">
      <div class="hero-inner">
        <div class="hero-text">
          <p class="eyebrow hero-eyebrow">
            <i class="live-dot" aria-hidden="true"></i>
            Senior GenAI Engineer · Databricks MVP · AI educator
          </p>
          <h1><span class="hand-underline">Sudarshan Koirala</span></h1>
          <p class="hero-typed">
            I build <b class="typed" data-typed={JSON.stringify(typedPhrases)}>{typedPhrases[0]}</b><i class="caret" aria-hidden="true"></i>
          </p>
          <p class="hero-tagline">
            Senior GenAI Engineer at <strong>KONE</strong>, where I ship enterprise agentic AI: AI agents,
            LLM applications, RAG, and the MLOps that keeps them reliable in production. I also teach
            applied AI to 24K+ developers through Data Science Basics.
          </p>
          <div class="hero-actions">
            <a class="button-primary button-glow" href="/cv">View CV</a>
            <a class="button-secondary" href="/resume">Resume</a>
            <a class="button-secondary" href="/about">About me</a>
          </div>
          <div class="hero-links">
            <a href="https://www.linkedin.com/in/sudarshan-koirala/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://www.youtube.com/@datasciencebasics" target="_blank" rel="noopener">YouTube</a>
            <a href="https://medium.com/@sudarshan-koirala" target="_blank" rel="noopener">Medium</a>
            <a href="https://github.com/sudarshan-koirala" target="_blank" rel="noopener">GitHub</a>
            <a href="https://topmate.io/sudarshan_koirala" target="_blank" rel="noopener">Consulting</a>
          </div>
        </div>
        <aside class="hero-profile" aria-label="Profile summary">
          <figure class="photo-ring">
            <img src="/profile.png" alt="Sudarshan Koirala" class="hero-photo" width="160" height="160" />
            <a class="mvp-float" href={recognition[0].href} target="_blank" rel="noopener" aria-label="Databricks MVP - open the MVP directory">
              <img src="/databricks-mvp.png" alt="" width="96" height="74" />
            </a>
          </figure>
          <div>
            <span>Current role</span>
            <strong>Senior GenAI Engineer, KONE</strong>
          </div>
          <div>
            <span>Recognition</span>
            <strong><a href={recognition[0].href} target="_blank" rel="noopener">{recognition[0].title}</a></strong>
          </div>
          <div>
            <span>Public work</span>
            <strong>Data Science Basics, Medium, GitHub</strong>
          </div>
          <div>
            <span>Location</span>
            <strong>Espoo, Finland</strong>
          </div>
        </aside>
      </div>
      <dl class="stat-strip hero-stats">
        {stats.map((stat, i) => (
          <div data-reveal style={`--d:${i}`}>
            <dt>{stat.label}</dt>
            <dd data-count={stat.value}>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="marquee" aria-label="Tools and technologies">
    <div class="marquee-track">
      <ul>
        {techStrip.map((item) => <li>{item}</li>)}
      </ul>
      <ul aria-hidden="true">
        {techStrip.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>

  <section class="section">
    <div class="container-wide">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">What I do</p>
          <h2 class="section-title-large">Enterprise AI work, explained in public.</h2>
        </div>
      </div>
      <div class="feature-grid">
        {focusAreas.map((area, i) => (
          <article class="feature-card spot" data-reveal style={`--d:${i}`}>
            <svg class="card-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[area.icon]} />
            <h3>{area.title}</h3>
            <p>{area.text}</p>
            <ul class="chip-row">
              {area.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container-wide">
      <div class="split-section">
        <div data-reveal>
          <p class="eyebrow">Experience at a glance</p>
          <h2 class="section-title-large">From physics to production GenAI.</h2>
          <p>
            Physics degree in Nepal, software engineering and an M.Sc. in Computer Science in Finland,
            ML work at Nokia, then KONE since January 2022, growing from Data Scientist Trainee to
            Senior GenAI Engineer.
          </p>
          <div class="inline-actions">
            <a href="/cv">Read full CV</a>
            <a href="/resume">One-page resume</a>
          </div>
        </div>
        <ol class="career-list">
          {milestones.map((item, i) => (
            <li data-reveal style={`--d:${i}`}>
              <span class="career-dates">{item.dates}</span>
              <strong>{item.title}</strong>
              <span class="career-org">{item.org}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Latest videos</p>
          <h2 class="section-title-large">Fresh from Data Science Basics</h2>
        </div>
        <a href="/videos" class="section-link">All videos</a>
      </div>
      <div class="video-row snap-row">
        {videos.map((video, i) => (
          <a class="video-tile" href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener" data-reveal style={`--d:${i}`}>
            <figure>
              <img src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
              <i class="play-button" aria-hidden="true"></i>
            </figure>
            <h3>{video.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container-wide">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Public channels</p>
          <h2 class="section-title-large">Where to follow the work</h2>
        </div>
      </div>
      <div class="channel-grid channel-grid-4">
        {channels.map((channel, i) => (
          <a class="channel-card spot" href={channel.href} target="_blank" rel="noopener" data-reveal style={`--d:${i}`}>
            <svg class="card-icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[channel.icon]} />
            <span>{channel.label}</span>
            <h3>{channel.title}</h3>
            <p>{channel.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <div class="section-head" data-reveal>
        <div>
          <p class="eyebrow">Projects</p>
          <h2 class="section-title-large">Things I build and share</h2>
        </div>
      </div>
      <div class="channel-grid snap-row">
        {projects.map((project, i) => (
          <a class="channel-card spot has-arrow" href={project.href} target="_blank" rel="noopener" data-reveal style={`--d:${i % 3}`}>
            <span>{project.label}</span>
            <h3>{project.title}</h3>
            <p>{project.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section-muted">
      <div class="container-wide">
        <div class="section-head" data-reveal>
          <div>
            <p class="eyebrow">Writing</p>
            <h2 class="section-title-large">Recent articles</h2>
          </div>
          <a href="/blog" class="section-link">View all</a>
        </div>
        <div class="card-grid" data-reveal>
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container-wide">
      <div class="cta-banner cta-wow" data-reveal>
        <div>
          <p class="eyebrow">Say hello</p>
          <h2>Let's build or learn something together</h2>
          <p>
            Consulting, a collaboration, a question about a video, or just a friendly hello.
            The quickest ways to reach me are right here.
          </p>
        </div>
        <div class="cta-actions">
          <a href="mailto:basicsdatascience@gmail.com">Email</a>
          <a href="https://topmate.io/sudarshan_koirala" target="_blank" rel="noopener">Consulting</a>
          <a href="https://www.youtube.com/@datasciencebasics?sub_confirmation=1" target="_blank" rel="noopener">
            Subscribe
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Typed line: types each phrase, pauses, deletes, then moves to the next one.
      const typed = document.querySelector('[data-typed]');
      if (typed && !reduce) {
        const phrases = JSON.parse(typed.dataset.typed);
        let phrase = 0;
        let length = phrases[0].length;
        let deleting = true;
        const tick = () => {
          const text = phrases[phrase];
          length += deleting ? -1 : 1;
          typed.textContent = text.slice(0, length);
          let delay = deleting ? 22 : 48;
          if (!deleting && length === text.length) { deleting = true; delay = 2200; }
          else if (deleting && length === 0) { deleting = false; phrase = (phrase + 1) % phrases.length; delay = 320; }
          setTimeout(tick, delay);
        };
        setTimeout(tick, 2400);
      }

      // Count-up for the public numbers, for example "1.9M+".
      const counters = document.querySelectorAll('[data-count]');
      if (!reduce && 'IntersectionObserver' in window) {
        const seen = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            seen.unobserve(entry.target);
            const match = entry.target.dataset.count.match(/^([\d.]+)(.*)$/);
            if (!match) return;
            const target = parseFloat(match[1]);
            const decimals = (match[1].split('.')[1] || '').length;
            const start = performance.now();
            const step = (now) => {
              const t = Math.min((now - start) / 1400, 1);
              const eased = 1 - Math.pow(1 - t, 3);
              entry.target.textContent = (target * eased).toFixed(decimals) + match[2];
              if (t < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
        }, { threshold: 0.6 });
        counters.forEach((el) => seen.observe(el));
      }

      // Hero background: a small network of agents that pass messages to each other.
      const canvas = document.querySelector('[data-agent-canvas]');
      const ctx = canvas && canvas.getContext('2d');
      if (!ctx) return;
      const hero = canvas.parentElement;
      const pointer = { x: -9999, y: -9999 };
      let nodes = [];
      let pulses = [];
      let width = 0;
      let height = 0;
      let color = '15,118,110';
      let running = false;
      let frame = 0;
      const LINK = 150;

      const readColor = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        color = dark ? '94,234,212' : '15,118,110';
      };
      const resize = () => {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        width = hero.clientWidth;
        height = hero.clientHeight;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        const count = Math.max(18, Math.min(64, Math.round((width * height) / 17000)));
        nodes = Array.from({ length: count }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.28,
          vy: (Math.random() - 0.5) * 0.28,
          r: 1.4 + Math.random() * 1.8,
        }));
        pulses = [];
      };
      const draw = () => {
        ctx.clearRect(0, 0, width, height);
        const links = [];
        for (let i = 0; i < nodes.length; i++) {
          const a = nodes[i];
          for (let j = i + 1; j < nodes.length; j++) {
            const b = nodes[j];
            const dist = Math.hypot(a.x - b.x, a.y - b.y);
            if (dist > LINK) continue;
            links.push([a, b]);
            ctx.strokeStyle = `rgba(${color},${0.2 * (1 - dist / LINK)})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
          const toPointer = Math.hypot(a.x - pointer.x, a.y - pointer.y);
          if (toPointer < 190) {
            ctx.strokeStyle = `rgba(${color},${0.45 * (1 - toPointer / 190)})`;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(pointer.x, pointer.y);
            ctx.stroke();
          }
          ctx.fillStyle = `rgba(${color},0.5)`;
          ctx.beginPath();
          ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2);
          ctx.fill();
        }
        if (frame % 14 === 0 && links.length && pulses.length < 14) {
          const [from, to] = links[Math.floor(Math.random() * links.length)];
          pulses.push({ from, to, t: 0 });
        }
        pulses = pulses.filter((pulse) => pulse.t <= 1);
        pulses.forEach((pulse) => {
          pulse.t += 0.022;
          const x = pulse.from.x + (pulse.to.x - pulse.from.x) * pulse.t;
          const y = pulse.from.y + (pulse.to.y - pulse.from.y) * pulse.t;
          ctx.fillStyle = `rgba(${color},0.95)`;
          ctx.shadowColor = `rgba(${color},0.9)`;
          ctx.shadowBlur = 10;
          ctx.beginPath();
          ctx.arc(x, y, 2.3, 0, Math.PI * 2);
          ctx.fill();
          ctx.shadowBlur = 0;
        });
      };
      const loop = () => {
        if (!running) return;
        frame += 1;
        nodes.forEach((node) => {
          node.x += node.vx;
          node.y += node.vy;
          if (node.x < 0 || node.x > width) node.vx *= -1;
          if (node.y < 0 || node.y > height) node.vy *= -1;
        });
        draw();
        requestAnimationFrame(loop);
      };
      const setRunning = (next) => {
        if (reduce || next === running) return;
        running = next;
        if (running) requestAnimationFrame(loop);
      };

      readColor();
      resize();
      draw();
      window.addEventListener('resize', () => { resize(); draw(); });
      new MutationObserver(() => { readColor(); draw(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      hero.addEventListener('pointermove', (event) => {
        const box = hero.getBoundingClientRect();
        pointer.x = event.clientX - box.left;
        pointer.y = event.clientY - box.top;
      });
      hero.addEventListener('pointerleave', () => { pointer.x = -9999; pointer.y = -9999; });
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => setRunning(entry.isIntersecting && !document.hidden)).observe(hero);
      } else {
        setRunning(true);
      }
      document.addEventListener('visibilitychange', () => setRunning(!document.hidden && hero.getBoundingClientRect().bottom > 0));
    })();
  </script>
</Base>
