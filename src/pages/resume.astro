---
import Base from '../layouts/Base.astro';
import { contact, summary, stats, experience, education, skillGroups, languages } from '../data/profile';
---

<Base title="Resume" description="One-page resume of Sudarshan Koirala, Senior GenAI Engineer at KONE and creator of Data Science Basics.">
  <div class="container document-container">
    <header class="document-header">
      <div>
        <p class="eyebrow">Resume</p>
        <h1>{contact.name}</h1>
        <p class="document-role">{contact.headline} · Machine Learning Engineer · AI Educator</p>
        <p class="document-contact">
          <span>{contact.location}</span>
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
          {contact.links.map((link) => (
            <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
          ))}
        </p>
      </div>
      <button class="print-link" type="button" onclick="window.print()">
        <span class="button-icon icon-print" aria-hidden="true"></span>
        <span>Print / Save PDF</span>
      </button>
    </header>

    <section class="document-section">
      <h2>Summary</h2>
      <p>{summary}</p>
      <p class="document-stack">
        {stats.map((stat) => `${stat.value} ${stat.label}`).join(' · ')}
      </p>
    </section>

    <section class="document-section">
      <h2>Experience</h2>
      {experience.map((role) => (
        <div class="document-item">
          <div class="document-item-head">
            <h3>{role.title} · {role.company}</h3>
            <span>{role.dates}</span>
          </div>
          <ul>
            {role.highlights.slice(0, 3).map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
      <p>Full details in the <a href="/cv">CV</a>.</p>
    </section>

    <section class="document-section">
      <h2>Education</h2>
      {education.map((item) => (
        <div class="document-item compact">
          <div class="document-item-head">
            <h3>{item.degree} · {item.school}</h3>
            <span>{item.dates}</span>
          </div>
          {item.details && <p>{item.details.join(' · ')}</p>}
        </div>
      ))}
    </section>

    <section class="document-section">
      <h2>Skills</h2>
      {skillGroups.map((group) => (
        <p><strong>{group.title}:</strong> {group.items.join(', ')}</p>
      ))}
      <p><strong>Languages:</strong> {languages.join(', ')}</p>
    </section>
  </div>
</Base>
